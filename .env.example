# Proveedor de IA para la interpretacion de texto libre.
# El flujo de carga manual (RF-17) funciona sin estas variables.
OPENROUTER_API_KEY=

# Opcional. Default en codigo: minimax/minimax-m3:free
# Se elige por velocidad: RNF-01 exige p95 < 10s y la extraccion es una tarea facil.
OPENROUTER_MODEL=
